# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Any chat model listed at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# For gpt-oss models: low | medium | high (higher = better notes, slower, more tokens)
REASONING_EFFORT=low

# Path to tesseract.exe (install from https://github.com/UB-Mannheim/tesseract/wiki)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Tesseract language(s), e.g. eng or eng+fra
OCR_LANG=eng

# Approximate tokens per chunk for summarization (lower this if you hit Groq rate limits)
CHUNK_TOKENS=3000
# Max length of the final study guide; higher = more detailed notes (lower it if Groq says "request too large")
NOTES_MAX_TOKENS=8000
